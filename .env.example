# Copy this file to .env and fill in real values. .env is never committed.

# PostgreSQL connection. Replace YOUR_PASSWORD with the password of the postgres user.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/aitechnician

# Signs the session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Set to true when the app is served over HTTPS so the session cookie is never sent over plain HTTP.
SESSION_HTTPS_ONLY=false

# Where uploaded files (voice notes) are kept. Back this folder up together with the database.
# MEDIA_DIR=D:/AITechnician/media

# Speech-to-text for voice notes. "local" runs faster-whisper on this machine (slow on a laptop CPU:
# roughly 3 minutes per minute of speech). The model downloads itself on first use.
# STT_ENGINE=local
# STT_LOCAL_MODEL=small        # base (faster, worse) | small | medium | large-v3 (better, much slower)
# STT_LANGUAGE=                # empty = detect per recording; "ta" forces Tamil
